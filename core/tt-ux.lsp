(defun TT:UXTaskDetail (/ task available)
  (setq task (nth (atoi (get_tile "tasks")) ux-tasks)
    available (or (not (nth 3 task)) ux-project))
  (set_tile "description" (nth 2 task))
  (set_tile "status" (if available "Continue starts this task. Back makes no changes."
    "Create or open a readable project first: Home > Project."))
  (mode_tile "accept" (if available 0 1)))

(defun TT:UXMenu (kind / *error* ux-tasks ux-project dialog-id choice selected)
  (defun *error* (message)
    (if (and dialog-id (> dialog-id 0)) (unload_dialog dialog-id))
    (TT:ReportError "Tools" message))
  (setq ux-tasks (TT:UXTasks kind) ux-project (TT:ProjectCurrent)
    dialog-id (load_dialog (TT:StorageJoinPath *TT:Root* "dialogs/terratools-main.dcl")))
  (if (and (> dialog-id 0) (new_dialog "terratools_tools" dialog-id))
    (progn
      (set_tile "title" (strcat "TerraTools | " (TT:UXTitle kind)))
      (set_tile "context" (TT:UXProjectContext ux-project))
      (set_tile "guide" (if (member kind '(IRR STATION CONTROLLER))
        "Equipment > Stations > Pipes > Verify > Size > Pressure > Output"
        "Choose a task to see what it does before continuing."))
      (start_list "tasks") (foreach selected ux-tasks (add_list (car selected))) (end_list)
      (set_tile "tasks" "0") (TT:UXTaskDetail)
      (action_tile "tasks" "(TT:UXTaskDetail)")
      (action_tile "accept" "(setq selected (nth (atoi (get_tile \"tasks\")) ux-tasks))(done_dialog 1)")
      (action_tile "cancel" "(setq selected nil)(done_dialog 0)")
      (setq choice (start_dialog)) (unload_dialog dialog-id) (setq dialog-id nil)
      (if (/= choice 1) (setq selected nil)))
    (progn
      (if (> dialog-id 0) (unload_dialog dialog-id)) (setq dialog-id nil)
      (setq selected (TT:PromptNumberedRecord ux-tasks 'TT:UXTaskLabel "Choose a task"))))
  (if selected
    (if (or (not (nth 3 selected)) (TT:ProjectCurrent))
      (apply (cadr selected) nil)
      (princ "\nOpen a readable project through TTPROJECT before using this task.")))
  (princ))

(defun TT:UXTitle (kind)
  (cond ((eq kind 'PROJECT) "Project") ((eq kind 'PLANTS) "Planting Tools")
    ((eq kind 'DATA) "Plant Libraries") ((eq kind 'OUTPUT) "Schedules / Reports")
    ((eq kind 'CHECK) "Verify / Diagnostics") ((eq kind 'RECOVERY) "Recovery")
    ((member kind '(IRR STATION CONTROLLER)) "Irrigation Tools")
    ((eq kind 'LIGHT) "Lighting Tools") ((eq kind 'DETAIL) "Detail Tools")
    ((eq kind 'SITE) "Site / Reference") ((eq kind 'WORK) "Work Area Tools") (T "Tools")))
(defun TT:UXPlantData () (TT:UXMenu 'DATA))
T

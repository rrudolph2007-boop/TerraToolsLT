;;; Presentation helpers only. Task entries are trusted code, never imported data.
(defun TT:UXCount (value / digits result)
  (setq digits (itoa (fix value)) result "")
  (while (> (strlen digits) 3)
    (setq result (strcat "," (substr digits (- (strlen digits) 2)) result)
          digits (substr digits 1 (- (strlen digits) 3))))
  (strcat digits result))

(defun TT:UXProjectContext (project)
  (strcat "Project: " (if project (TT:ProjectValue project 'PROJECT_NAME) "None. Create or open a project to begin.")))

(defun TT:UXAreaContext (project / area)
  (setq area (if project (TT:WorkAreaFind project (TT:ActiveWorkArea project))))
  (strcat "New placements: " (if area (TT:DataValue area 'NAME) "No active Work Area")))

(defun TT:UXDatabaseBanner (manifest)
  (if manifest
    (strcat "Open Plant Database: " (TT:UXCount (TT:DataValue manifest 'ACCEPTED_COUNT))
      " plants available | " (TT:DataValue manifest 'DATABASE_VERSION))
    "Open Plant Database unavailable. Built-in samples are still available."))

(defun TT:UXTaskLabel (task) (car task))

